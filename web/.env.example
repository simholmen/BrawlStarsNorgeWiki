# Copy to .env.local and fill in. .env.local is gitignored.
# Supabase project URL and the PUBLISHABLE key (public, read-only via RLS).
# Never put the secret key here: the web app only ever reads.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Path to the Jekyll docs/ folder (images, tournament YAML). Defaults to ../docs.
# WIKI_DOCS_DIR=../docs
