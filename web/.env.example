# Copy to .env.local and fill in. .env.local is gitignored.
# Supabase project URL and the PUBLISHABLE key. Both are public (RLS decides what the key may do)
# and the browser login needs them, hence NEXT_PUBLIC_. Never put the secret key here.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Path to the Jekyll docs/ folder (images, tournament YAML). Defaults to ../docs.
# WIKI_DOCS_DIR=../docs
