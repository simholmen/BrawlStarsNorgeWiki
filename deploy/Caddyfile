# Caddy config for the droplet: the production site, www, and the old beta address.
# Install: replace __REPO_DIR__ with the site clone's path (/srv/bsnorge-wiki), copy to
# /etc/caddy/Caddyfile, then `sudo systemctl reload caddy`. Caddy gets each HTTPS certificate
# automatically once that name's DNS points at the droplet.
#
# Static files come straight from docs/ (no copies), /ingest/* goes to PostHog, everything else
# goes to Next.js.

(wiki) {
	encode zstd gzip

	# Landing page, images, ranked-stats page and the shared script: served from docs/ as-is.
	@static {
		path / /index.html /script.js /analytics.js /images/* /rankedstats/*
	}
	handle @static {
		root * __REPO_DIR__/docs
		file_server
	}

	# PostHog analytics (EU cloud) through our own domain, so ad blockers don't drop it and the
	# browser never talks to PostHog directly. Our cookies (the Supabase login) are stripped.
	# The library itself comes from the assets host; events go to the ingestion host.
	handle_path /ingest/* {
		@posthog_assets path /static/* /array/*
		handle @posthog_assets {
			reverse_proxy https://eu-assets.i.posthog.com {
				header_up Host eu-assets.i.posthog.com
				header_up -Cookie
				header_up -Authorization
			}
		}
		handle {
			reverse_proxy https://eu.i.posthog.com {
				header_up Host eu.i.posthog.com
				header_up -Cookie
				header_up -Authorization
			}
		}
	}

	handle {
		reverse_proxy 127.0.0.1:3000
	}
}

brawlstarsnorge.com {
	import wiki
}

www.brawlstarsnorge.com {
	redir https://brawlstarsnorge.com{uri} permanent
}

# Staging address from the migration. Still serves the site (not indexed) so old links and
# logins keep working; can become a redirect to brawlstarsnorge.com later.
beta.brawlstarsnorge.com {
	header X-Robots-Tag "noindex"
	import wiki
}
